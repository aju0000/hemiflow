# Prevent direct access to database files, SQL dumps, and sensitive environment/git files
<FilesMatch "(\.db|\.sqlite|\.sqlite3|\.sql|\.env|\.git|\.lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Disable directory indexing
Options -Indexes

# Set default charset
AddDefaultCharset UTF-8
